# Builds NOOP (https://github.com/ryanbr/noop) and uploads it to TestFlight.
#
# This follows the Loop / Trio "browser build": the same six secrets, the same
# Match-Secrets repository, the same numbered workflows. The NOOP source itself
# is not stored in this repository. The build workflow checks it out into ./noop.

require "json"
require "open3"
require "time"
require "xcodeproj"

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"] || Dir.pwd
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

# Where the build workflow checks out the NOOP source.
NOOP_DIR = File.join(GITHUB_WORKSPACE, "noop")
NOOP_PROJECT = File.join(NOOP_DIR, "Strand.xcodeproj")
NOOP_SCHEME = "NOOPiOS"
IPA_PATH = File.join(GITHUB_WORKSPACE, "NOOP.ipa")
BUILD_INFO_PATH = File.join(GITHUB_WORKSPACE, "build_info.json")

# Same convention as Loop: the Apple Team ID makes the bundle ids unique to you.
BUNDLE_ID_PREFIX = "com.#{TEAMID}"
APP_ID = "#{BUNDLE_ID_PREFIX}.noop"
# NOOP derives its App Group from the same prefix (see its project.yml).
APP_GROUP_ID = "group.#{BUNDLE_ID_PREFIX}.noop.staging"

# Xcode target => identifier registered with Apple.
# Every target shares the App Group; the two apps also use HealthKit.
NOOP_TARGETS = {
  "NOOPiOS" => { id: APP_ID, name: "NOOP", healthkit: true },
  "NOOPiOSWidgets" => { id: "#{APP_ID}.widgets", name: "NOOP Widgets", healthkit: false },
  "NOOPWatch" => { id: "#{APP_ID}.watch", name: "NOOP Watch", healthkit: true },
  "NOOPWatchComplications" => { id: "#{APP_ID}.watch.complications", name: "NOOP Watch Complications", healthkit: false }
}
NOOP_APP_IDS = NOOP_TARGETS.values.map { |target| target[:id] }

def asc_api_key
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID.to_s,
    issuer_id: FASTLANE_ISSUER_ID.to_s,
    key_content: FASTLANE_KEY.to_s
  )
end

def match_git_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

# Reads a top-level value such as MARKETING_VERSION out of NOOP's project.yml.
def noop_project_setting(key)
  text = File.read(File.join(NOOP_DIR, "project.yml"), encoding: "UTF-8").scrub
  match = text.match(/^\s*#{Regexp.escape(key)}:\s*"?([^"\s#]+)"?/)
  match ? match[1] : nil
end

# Every target that ends up inside the iOS app (the app itself, its extensions,
# the watch app and the watch app's extensions).
def targets_inside_app(project)
  root = project.native_targets.find { |target| target.name == NOOP_SCHEME }
  UI.user_error!("The NOOP project has no '#{NOOP_SCHEME}' target any more. This build setup needs updating.") if root.nil?
  found = []
  queue = [root]
  until queue.empty?
    target = queue.shift
    next if target.nil? || found.include?(target) || !target.respond_to?(:dependencies)
    found << target
    target.dependencies.each { |dependency| queue << dependency.target }
  end
  found
end

# Generates Strand.xcodeproj for this Apple team and applies the two build-time
# tweaks. Nothing here is committed anywhere. It only changes the checked-out copy.
def prepare_noop_project
  unless File.exist?(File.join(NOOP_DIR, "project.yml"))
    UI.user_error!("NOOP source not found in #{NOOP_DIR}. The workflow checks it out before this lane runs.")
  end

  # NOOP reads its bundle-id prefix and team from this file (see its docs/IOS.md).
  File.write(
    File.join(NOOP_DIR, "Config", "BundleIdSecrets.xcconfig"),
    "BUNDLE_ID_PREFIX = #{BUNDLE_ID_PREFIX}\nDEVELOPMENT_TEAM = #{TEAMID}\n"
  )

  Dir.chdir(NOOP_DIR) { sh("xcodegen", "generate") }

  project = Xcodeproj::Project.open(NOOP_PROJECT)
  inside_app = targets_inside_app(project).map(&:name)
  missing = NOOP_TARGETS.keys - inside_app
  unknown = inside_app - NOOP_TARGETS.keys
  unless missing.empty? && unknown.empty?
    UI.user_error!(
      "NOOP's targets changed upstream (missing: #{missing.inspect}, new: #{unknown.inspect}). " \
      "NOOP_TARGETS in fastlane/Fastfile needs updating, then run '2. Add Identifiers' again."
    )
  end

  # Tell App Store Connect the app only uses the encryption built into iOS
  # (HTTPS, Keychain, CommonCrypto). Without this key every new TestFlight build
  # waits for someone to answer the export compliance question by hand.
  app_target = project.native_targets.find { |target| target.name == NOOP_SCHEME }
  plist = app_target.build_configurations.map { |config| config.build_settings["INFOPLIST_FILE"] }.compact.first
  plist_path = plist && File.join(NOOP_DIR, plist)
  if plist_path && File.exist?(plist_path)
    set_info_plist_value(path: plist_path, key: "ITSAppUsesNonExemptEncryption", value: false)
  else
    UI.important("Could not find the iOS Info.plist. New builds may ask for export compliance in App Store Connect.")
  end
end

# Switches the four targets from Xcode's automatic signing to the distribution
# certificate and provisioning profiles that match installed.
def apply_distribution_signing(profile_mapping)
  project = Xcodeproj::Project.open(NOOP_PROJECT)
  target_attributes = project.root_object.attributes["TargetAttributes"]

  NOOP_TARGETS.each do |target_name, info|
    profile = (profile_mapping || {})[info[:id]]
    if profile.to_s.empty?
      UI.user_error!("No provisioning profile found for #{info[:name]}. Run '3. Create Certificates' and try again.")
    end

    target = project.native_targets.find { |candidate| candidate.name == target_name }
    target.build_configurations.each do |config|
      settings = config.build_settings
      settings.delete_if do |key, _|
        key.start_with?("CODE_SIGN_IDENTITY[", "PROVISIONING_PROFILE_SPECIFIER[", "PROVISIONING_PROFILE[", "DEVELOPMENT_TEAM[")
      end
      settings.delete("PROVISIONING_PROFILE")
      settings["CODE_SIGN_STYLE"] = "Manual"
      settings["DEVELOPMENT_TEAM"] = TEAMID
      settings["CODE_SIGN_IDENTITY"] = "iPhone Distribution"
      settings["PROVISIONING_PROFILE_SPECIFIER"] = profile
    end

    if target_attributes && target_attributes[target.uuid]
      target_attributes[target.uuid]["ProvisioningStyle"] = "Manual"
      target_attributes[target.uuid]["DevelopmentTeam"] = TEAMID
    end
  end

  project.save
end

# The App Groups a provisioning profile grants, read from the profile itself.
def profile_app_groups(path)
  xml, status = Open3.capture2("security", "cms", "-D", "-i", path)
  return [] unless status.success?
  section = xml.scrub[%r{<key>com\.apple\.security\.application-groups</key>\s*<array>(.*?)</array>}m, 1]
  section ? section.scan(%r{<string>(.*?)</string>}).flatten : []
end

# Where match installed the profile for one identifier.
def installed_profile_path(identifier)
  path = ENV["sigh_#{identifier}_appstore_profile-path"]
  return path if path && File.exist?(path)
  folders = ["~/Library/Developer/Xcode/UserData/Provisioning Profiles", "~/Library/MobileDevice/Provisioning Profiles"]
  Dir.glob(folders.map { |folder| File.join(File.expand_path(folder), "*.mobileprovision") }).find do |candidate|
    xml, = Open3.capture2("security", "cms", "-D", "-i", candidate)
    xml.scrub.include?("<string>match AppStore #{identifier}</string>")
  end
end

# The NOOP identifiers whose installed profile does not grant the NOOP App Group.
def targets_without_app_group
  NOOP_TARGETS.values.reject do |info|
    path = installed_profile_path(info[:id])
    path && profile_app_groups(path).include?(APP_GROUP_ID)
  end
end

# Prints which App Groups each installed profile grants, to show what Apple has
# on file. Team IDs other than your own are replaced, because this log is public.
def report_profile_app_groups
  NOOP_TARGETS.each_value do |info|
    path = installed_profile_path(info[:id])
    if path.nil?
      UI.message("#{info[:name]}: no installed profile found")
      next
    end
    groups = profile_app_groups(path).map do |group|
      group.gsub(/\b[A-Z0-9]{10}\b/) { |token| token == TEAMID ? token : "<another-team-id>" }
    end
    UI.message("#{info[:name]}: profile grants #{groups.empty? ? 'no App Groups' : groups.join(', ')}")
  end
end

def find_or_create_bundle_id(name, identifier, capabilities)
  bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
    name: name,
    identifier: identifier,
    platform: "IOS"
  )
  existing = bundle_id.get_capabilities.map(&:capability_type)
  capabilities.reject { |capability| existing.include?(capability) }.each do |capability|
    bundle_id.create_capability(capability)
  end
end

# limit lane names to letters and underscores
platform :ios do
  desc "Build NOOP and export a signed .ipa"
  lane :build_noop do
    setup_ci if ENV["CI"]

    prepare_noop_project

    api_key = asc_api_key

    # Fails here, before the long compile, if the app record is missing.
    begin
      previous_build_number = latest_testflight_build_number(
        app_identifier: APP_ID,
        api_key: api_key,
        initial_build_number: 0
      ).to_i
    rescue StandardError => error
      if error.message.include?("Could not find an app")
        UI.user_error!(
          "NOOP does not exist in App Store Connect yet. Create it at https://appstoreconnect.apple.com/apps " \
          "(+ > New App > iOS, bundle ID ending in '.noop'), then run this build again. See README.md."
        )
      end
      raise
    end

    # NOOP numbers its own builds. Keep that number when it is new to TestFlight,
    # otherwise count up from the last upload so a rebuild is never rejected as a duplicate.
    version = noop_project_setting("MARKETING_VERSION") || "0"
    upstream_build_number = noop_project_setting("CURRENT_PROJECT_VERSION").to_i
    build_number = [previous_build_number + 1, upstream_build_number].max
    UI.important("Building NOOP #{version} as build #{build_number} (NOOP's own build number: #{upstream_build_number})")

    match(
      type: "appstore",
      git_basic_authorization: match_git_auth,
      app_identifier: NOOP_APP_IDS
    )

    apply_distribution_signing(Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING])

    gym(
      project: NOOP_PROJECT,
      scheme: NOOP_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      output_directory: GITHUB_WORKSPACE,
      output_name: "NOOP.ipa",
      buildlog_path: File.join(GITHUB_WORKSPACE, "buildlog"),
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    File.write(BUILD_INFO_PATH, JSON.pretty_generate("version" => version, "build" => build_number))
  end

  desc "Upload the .ipa to TestFlight and wait until Apple has processed it"
  lane :release do
    api_key = asc_api_key

    info = File.exist?(BUILD_INFO_PATH) ? JSON.parse(File.read(BUILD_INFO_PATH, encoding: "UTF-8")) : {}
    source = [ENV["NOOP_UPSTREAM_REPO"], ENV["NOOP_UPSTREAM_REF"]].compact.join(" ")
    commit = ENV["NOOP_UPSTREAM_SHA"].to_s[0, 7]
    changelog = "NOOP #{info['version']} (build #{info['build']}), built from #{source} #{commit}".strip

    begin
      upload_to_testflight(
        api_key: api_key,
        ipa: IPA_PATH,
        skip_submission: false,
        skip_waiting_for_build_processing: false,
        wait_processing_timeout_duration: 3600,
        distribute_external: false,
        changelog: changelog
      )
    rescue StandardError => error
      if error.message.include?("BuildWatcher")
        UI.user_error!(
          "The upload reached Apple, but the build did not finish processing within an hour. " \
          "Apple emails the account holder when it rejects a build during processing, so check that inbox."
        )
      end
      raise
    end
  end

  desc "Register the four NOOP identifiers with Apple"
  lane :identifiers do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s

    asc_api_key

    NOOP_TARGETS.each_value do |info|
      capabilities = [Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS]
      capabilities << Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT if info[:healthkit]
      find_or_create_bundle_id(info[:name], info[:id], capabilities)
    end
  end

  desc "Create or refresh the distribution certificate and provisioning profiles"
  lane :certs do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s

    asc_api_key

    match(
      type: "appstore",
      force: false,
      git_basic_authorization: match_git_auth,
      app_identifier: NOOP_APP_IDS
    )

    # A profile made before the App Group was added to its identifier still
    # looks valid to match, but Xcode refuses to sign with it. Recreate those.
    stale = targets_without_app_group
    unless stale.empty?
      UI.important("Recreating the profiles that do not include the NOOP App Group yet: #{stale.map { |info| info[:name] }.join(', ')}")
      match(
        type: "appstore",
        force: true,
        git_basic_authorization: match_git_auth,
        app_identifier: stale.map { |info| info[:id] }
      )
      stale = targets_without_app_group
    end

    report_profile_app_groups
    if stale.empty?
      UI.success("All four NOOP profiles include the App Group #{APP_GROUP_ID}.")
    else
      UI.important("Expected App Group: #{APP_GROUP_ID}")
      UI.user_error!(
        "Apple's profiles do not include the App Group for: #{stale.map { |info| info[:name] }.join(', ')}. " \
        "At https://developer.apple.com/account/resources/identifiers/list open each of these identifiers, " \
        "click Configure (or Edit) next to App Groups, tick 'NOOP App Group', then Save. The App Group's own " \
        "identifier must be exactly group.com.TEAMID.noop.staging, where TEAMID is your Apple Team ID."
      )
    end
  end

  desc "Validate Secrets"
  lane :validate_secrets do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = true.to_s

    asc_api_key

    # Proves the App Store Connect key works. The identifier does not have to exist yet.
    Spaceship::ConnectAPI::BundleId.find(APP_ID)

    # Proves GH_PAT can read Match-Secrets and MATCH_PASSWORD can decrypt it.
    match(
      type: "appstore",
      git_basic_authorization: match_git_auth,
      app_identifier: []
    )
  end

  desc "Nuke Certs"
  lane :nuke_certs do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s

    asc_api_key

    match_nuke(
      type: "appstore",
      team_id: TEAMID.to_s,
      skip_confirmation: true,
      git_basic_authorization: match_git_auth
    )
  end

  desc "Check whether the distribution certificate is missing or expired"
  lane :check_and_renew_certificates do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s

    asc_api_key

    new_certificate_needed = false
    distribution_certs = Spaceship::ConnectAPI::Certificate.all.select do |cert|
      cert.certificate_type == "DISTRIBUTION"
    end

    if distribution_certs.empty?
      puts "No Distribution certificate found."
      new_certificate_needed = true
    else
      distribution_certs.each do |cert|
        expiration_date = Time.parse(cert.expiration_date)
        if expiration_date < Time.now
          puts "A Distribution certificate expired on #{expiration_date}."
          new_certificate_needed = true
        else
          puts "A Distribution certificate is valid until #{expiration_date}."
        end
      end
    end

    file_path = File.expand_path("new_certificate_needed.txt")
    File.write(file_path, new_certificate_needed ? "true" : "false")
    puts "Certificate creation or renewal needed: #{new_certificate_needed}"
  end
end
